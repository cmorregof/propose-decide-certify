# entorno y cachés
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store
build/
dist/

# claves: nunca
.env
.env.*

# auxiliares de LaTeX
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.listing
*.synctex.gz
docs/curso/tex/*.pdf

# corridas: se versiona la estructura y los informes, no los registros pesados
runs/**/llamadas.jsonl
logs/*.sqlite
logs/*.lock
logs/**/*.pid
tests/unirl/fixtures/pruebas_privadas/
runs/didactica/**
runs/pep/**
# los .log de logs/ son registros de corridas, no de LaTeX
!logs/*.log
!logs/**/*.log
# la ronda en marcha: estado transitorio y ensayos en seco (los registros de la ronda real sí se versionan)
logs/ronda_actual
logs/ronda3_actual
logs/ronda_dryrun_*
logs/ronda_dryrun_*.log

